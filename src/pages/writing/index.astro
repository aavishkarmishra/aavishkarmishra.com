---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
    .replace(/ /g, '\u2009');
---
<Base title="Writing" description="Notes on backend systems, pipelines, and the tradeoffs behind them.">
  <h1>Writing</h1>
  <p class="dim lede-sub">
    Mostly post-mortems of my own decisions: what the constraint was, what I
    turned down, and what it cost to find out.
  </p>

  {posts.length === 0 ? (
    <p class="dim">Nothing published yet. The drafts folder, however, is thriving.</p>
  ) : (
    <ul class="entries dated">
      {posts.map((p) => (
        <li>
          <span class="entry-meta nums">{fmt(p.data.date)}</span>
          <div>
            <a class="entry-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
            <p class="entry-desc">{p.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .lede-sub { font-size: 0.9375rem; line-height: 1.6; margin: 0.5rem 0 2rem; }

</style>
