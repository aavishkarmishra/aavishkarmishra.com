---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist." noindex>
  <h1>404</h1>
  <p class="lede">Not all who wander are lost. You, however, are.</p>
  <p class="dim">
    This page does not exist and probably never did. Try the
    <a href="/writing">writing</a>, the <a href="/work">work</a>, or the
    <a href="/">front page</a>. If a link sent you here, tell me and I will
    go and fix it.
  </p>
</Base>

<style>
  h1 { font-family: var(--mono); font-size: 3rem; letter-spacing: -0.03em; margin-bottom: 1rem; }
  p { margin: 0 0 0.9rem; }
</style>
