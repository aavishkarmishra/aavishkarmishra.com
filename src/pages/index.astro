---
import Base from '../layouts/Base.astro';
import { site, hasPortrait, now } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.filter((p) => p.data.featured);
const recent = posts.filter((p) => !p.data.featured).slice(0, 5);
---
<Base>
  <div class="intro">
    {hasPortrait && (
      <img class="portrait" src="/portrait.jpg" width="96" height="96"
           alt="Aavishkar Mishra" fetchpriority="high" />
    )}
    <div>
      <h1>Aavishkar Mishra</h1>
      <p class="lede">{site.tagline}</p>
      <p class="dim intro-second">
        Founding engineer at Scream for two years, in a team of three engineers
        and two designers, which is small enough that I worked across most of
        the stack: backend, frontend, the model in the middle, the deploys. Now
        at <a href="https://helply.com">Helply</a>, rebuilding the
        email-rendering pipeline and notes architecture of a support platform
        that has been running for over a decade.
      </p>
      <p class="now"><span class="now-label">Now</span>{now}</p>
      <p class="inline-links">
        {site.location}<span class="sep">·</span><a href={`mailto:${site.email}`}>Email</a
        ><span class="sep">·</span><a href={site.github}>GitHub</a
        ><span class="sep">·</span><a href={site.linkedin}>LinkedIn</a>
      </p>
    </div>
  </div>

  {featured.length > 0 && (
    <section>
      <p class="eyebrow">Selected work</p>
      <ul class="entries">
        {featured.map((p) => (
          <li>
            <a class="entry-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
            <p class="entry-desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <figure class="epigraph">
    <blockquote>
      It is our choices, Harry, that show what we truly are, far more than our
      abilities.
    </blockquote>
    <figcaption>Dumbledore, <cite>Harry Potter and the Chamber of Secrets</cite></figcaption>
  </figure>

  {recent.length > 0 && (
    <section>
      <p class="eyebrow">Writing</p>
      <ul class="entries">
        {recent.map((p) => (
          <li><a class="entry-title" href={`/writing/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
      <a class="more" href="/writing">All writing</a>
    </section>
  )}
</Base>

<style>
  .intro { display: flex; gap: 1.25rem; align-items: flex-start; }
  .portrait {
    flex: none;
    width: 96px; height: 96px;
    object-fit: cover;
    border-radius: 3px;
    filter: saturate(0.92);
  }
  .intro h1 { margin-bottom: 0.4rem; }
  .intro-second { font-size: 0.9375rem; line-height: 1.6; margin: 0.75rem 0 0.9rem; }
  .now {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .now-label {
    font: 500 0.6875rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 0.6rem;
  }
  section { margin-top: 3.25rem; }
  @media (max-width: 30rem) {
    .intro { flex-direction: column; gap: 1rem; }
  }
</style>
