---
import Base from '../layouts/Base.astro';
import { site, hasPortrait, now } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recent = posts.slice(0, 5);
---
<Base description="Aavishkar Mishra, full-stack engineer in Bengaluru. Founding engineer on three SaaS products, now building an AI-native support platform at Helply.">
  <div class="intro">
    {hasPortrait && (
      <img class="portrait" src="/portrait.jpg" width="96" height="96"
           alt="Aavishkar Mishra" fetchpriority="high" />
    )}
    <div>
      <h1>Aavishkar Mishra</h1>
      <p class="lede">{site.tagline}</p>
      <p class="dim intro-second">
        Founding engineer on three SaaS products taken from zero to paying
        customers, writing whatever the product needed next: backend, frontend,
        applied AI, infrastructure. Now at <a href="https://helply.com">Helply</a>,
        building core features of an AI-native B2B support platform.
      </p>
      <p class="now"><span class="now-label">Now</span>{now}</p>
      <p class="inline-links">
        {site.location}<span class="sep">·</span><a href={`mailto:${site.email}`}>Email</a
        ><span class="sep">·</span><a href={site.github}>GitHub</a
        ><span class="sep">·</span><a href={site.linkedin}>LinkedIn</a>
      </p>
    </div>
  </div>

  {recent.length > 0 && (
    <section>
      <p class="eyebrow">Writing</p>
      <ul class="entries">
        {recent.map((p) => (
          <li>
            <a class="entry-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
            <p class="entry-desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
      <a class="more" href="/writing">All writing</a>
    </section>
  )}
</Base>

<style>
  .intro { display: flex; gap: 1.25rem; align-items: flex-start; }
  .portrait {
    flex: none;
    width: 96px; height: 96px;
    object-fit: cover;
    border-radius: 3px;
    filter: saturate(0.92);
  }
  .intro h1 { margin-bottom: 0.4rem; }
  .intro-second { font-size: 0.9375rem; line-height: 1.6; margin: 0.75rem 0 0.9rem; }
  .now {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .now-label {
    font: 500 0.6875rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 0.6rem;
  }
  section { margin-top: 3.25rem; }
  @media (max-width: 30rem) {
    .intro { flex-direction: column; gap: 1rem; }
  }
</style>
