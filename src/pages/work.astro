---
import Base from '../layouts/Base.astro';

const roles = [
  {
    when: '2025 — Present',
    role: 'Software Engineer',
    org: 'Helply',
    detail:
      'Building an AI-native B2B support platform in NestJS and SQL. I take core product features from design to production; lately that has meant email rendering and notes.',
  },
  {
    when: '2023 — 2025',
    role: 'Founding Engineer',
    org: 'Scream Creator Technologies',
    detail:
      'Three products from zero to paying customers. I built the video pipeline end to end, capture to export, and the payment lifecycle across Stripe and Razorpay: subscriptions, GST invoicing, refunds, disputes. When 4K exports outgrew Lambda’s fifteen-minute ceiling, we moved rendering onto the user’s machine instead of building our own renderer.',
    more: { text: 'The render story, in full', href: '/writing/rendering-was-never-the-problem/' },
  },
  {
    when: '2023',
    role: 'Engineering Intern',
    org: 'Scream Creator Technologies',
    detail:
      'Replaced a third-party email vendor with an event-driven pipeline on SES and Lambda; bounces, suppression and retries became ours. Took public-page Lighthouse scores from 68 to 95.',
  },
  {
    when: '2019 — 2023',
    role: 'B.Tech, Computer Science & Engineering',
    org: 'Tezpur University',
    detail: 'CGPA 8.09 / 10.',
  },
];

const projects = [
  {
    name: 'Manthan',
    href: 'https://github.com/Manthan933/Manthan',
    stack: 'React · Node · Express · MongoDB',
    detail:
      'A proctored online exam platform with webcam monitoring and plagiarism detection, built from scratch and used by three institutes and around 350 students. I open-sourced it once it worked; 41 contributors and 145 forks have arrived since.',
  },
  {
    name: 'Algorithmic trading bots',
    href: 'https://github.com/aavishkarmishra',
    stack: 'Go · Kite Connect',
    detail:
      'Trading systems in Go against Zerodha’s Kite Connect API: market data, order placement, strategy execution. Built to learn Go properly and to find out whether my ideas about markets survived contact with one.',
  },
  {
    name: 'DETR, reimplemented',
    href: 'https://github.com/aavishkarmishra/detr-tensorflow',
    stack: 'TensorFlow · Keras',
    detail:
      'End-to-End Object Detection with Transformers, rebuilt from the paper in TensorFlow, with web inference through OpenCV. Never trained to convergence — that takes 300 epochs on eight GPUs — so it is a study of set prediction and the matching loss, not a reproduction of its numbers.',
  },
];

const stack = [
  'TypeScript', 'NestJS', 'Node', 'Go', 'Python', 'FastAPI', 'React',
  'SQL / Postgres', 'Redis', 'MongoDB',
  'AWS — Lambda, SES, S3, EC2, CloudFront', 'Linux', 'GitHub Actions',
  'FFmpeg', 'TensorFlow',
];
---
<Base title="Work" description="Experience, projects, and the systems I have owned end to end.">
  <h1>Work</h1>
  <p class="dim lede-sub">
    Three years of building products, most of it as the person who also
    carried the pager for them.
  </p>

  <p class="eyebrow">Experience</p>
  <ul class="timeline">
    {roles.map((r) => (
      <li>
        <span class="when nums">{r.when}</span>
        <div class="what">
          <div class="role">{r.role}<span class="org">, {r.org}</span></div>
          <p class="detail">{r.detail}</p>
          {r.more && <p class="detail-more"><a href={r.more.href}>{r.more.text}</a></p>}
        </div>
      </li>
    ))}
  </ul>

  <p class="eyebrow spaced">How I work</p>
  <ul class="how">
    <li>I price a design before I commit to it, and the price includes our own
      time. Building our own renderer was the interesting option and the wrong
      one.</li>
    <li>I read the platform limits before designing around them. Lambda caps
      execution at fifteen minutes. That one number decided the shape of our
      whole export pipeline.</li>
  </ul>

  <p class="eyebrow spaced">Projects</p>
  <ul class="entries">
    {projects.map((p) => (
      <li>
        <a class="entry-title" href={p.href}>{p.name}</a>
        <p class="entry-desc">{p.detail}</p>
        <span class="entry-meta">{p.stack}</span>
      </li>
    ))}
  </ul>

  <p class="eyebrow spaced">Tools I reach for</p>
  <p class="stack">{stack.join('  ·  ')}</p>

  <p class="eyebrow spaced">Outside work</p>
  <p class="outside">
    I read, I travel when the calendar allows, and I watch more films, shows
    and anime than I can reasonably defend. Currently: learning to swim.
  </p>
</Base>

<style>
  .lede-sub { font-size: 0.9375rem; line-height: 1.6; margin: 0.5rem 0 2.25rem; }
  .eyebrow.spaced { margin-top: 3.25rem; }
  .how { list-style: none; margin: 0; padding: 0; }
  .how li {
    padding-left: 1.1rem;
    position: relative;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .how li + li { margin-top: 0.7rem; }
  .how li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--faint);
  }
  .entries .entry-meta { display: block; margin-top: 0.4rem; }
  .detail-more { margin: 0.5rem 0 0; font: 400 0.875rem/1 var(--sans); }
  .detail-more a { text-decoration: none; }
  .detail-more a::after { content: " \2192"; }
  .stack { font: 400 0.875rem/1.9 var(--sans); color: var(--muted); }
  .outside { font-size: 0.9375rem; line-height: 1.6; color: var(--muted); margin: 0; }
</style>
