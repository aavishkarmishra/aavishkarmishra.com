---
import Base from '../layouts/Base.astro';
import { books } from '../data/reading';
---
<Base title="Reading" description="Books I have something specific to say about.">
  <h1>Reading</h1>
  <p class="dim lede-sub">
    Only books I have something specific to say about. I finish maybe half of
    what I start, so this list is shorter than my shelf and considerably more
    honest than my intentions.
  </p>

  <ul class="entries">
    {books.map((b) => (
      <li>
        {b.href
          ? <a class="entry-title" href={b.href}>{b.title}</a>
          : <span class="entry-title">{b.title}</span>}
        <span class="entry-meta by">{b.author}</span>
        <p class="entry-desc">{b.note}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lede-sub { font-size: 0.9375rem; line-height: 1.6; margin: 0.5rem 0 2.25rem; }
  .by { margin-left: 0.55rem; }
</style>
